generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VisitType {
  IN
  OUT
}

model User {
  userId   Int    @id @default(autoincrement())
  username String
  password String
}

model LogVisitor {
  idLog           Int       @id @default(autoincrement())
  rfidTag         String
  nik             String    // Foreign key ke Visitor
  date            DateTime
  visitType       VisitType // "IN" atau "OUT"
  location        String?
  visitor         Visitor   @relation(fields: [nik], references: [nik])
  rfidTagRelation RfidTag   @relation(fields: [rfidTagId], references: [rfidTag])
  rfidTagId       String    // Foreign key ke RfidTag
}

model Visitor {
  id               Int          @id @default(autoincrement())
  nik              String       @unique
  name             String
  address          String
  birthInfo        String
  nationality      String?
  phoneNumber      String?
  organization     String?
  visitingPurpose  String?
  placeDestination String?
  personToVisit    String?
  vehicleNumber    String?
  logVisitors      LogVisitor[]
  rfidTags         RfidTag[]
}

model RfidTag {
  rfidTag     String       @id
  nik         String?
  status      Boolean
  logVisitors LogVisitor[]
  visitor     Visitor?     @relation(fields: [nik], references: [nik], onDelete: Restrict, onUpdate: Cascade)
}